{
    "name": "nimbuscms/markdown",
    "description": "A Markdown field type for NimbusCMS. The official reference plugin.",
    "type": "nimbuscms-plugin",
    "keywords": [
        "nimbuscms",
        "nimbuscms-plugin",
        "markdown",
        "cms"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "DanMat"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "nimbuscms/nimbus": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/NimbusCMS/nimbus"
        }
    ],
    "autoload": {
        "psr-4": {
            "NimbusCMS\\Markdown\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NimbusCMS\\Markdown\\Tests\\": "tests/"
        }
    },
    "extra": {
        "nimbus": {
            "id": "nimbuscms.markdown",
            "plugin": "NimbusCMS\\Markdown\\MarkdownPlugin"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ],
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
